#!/bin/bash
SCRIPT="$(readlink -f "${BASH_ARGV0:-${0}}")"
BASEDIR="$(dirname "${SCRIPT}")"
SCRIPT="$(basename "${SCRIPT}")"

set -e -o pipefail

echo_run()
{
	local ARGS=("${@}")
	echo "${ARGS[@]@Q}"
	"${@}"
}

REPO_NAME="external-secrets"
REPO_URL="https://charts.external-secrets.io"
[ -v APP_NS ] || APP_NS="external-secrets"

#
# Remove the VSO if installed
#
kubectl delete namespace vault-secrets-operator || true

helm repo add --force-update "${REPO_NAME}" "${REPO_URL}"

echo_run helm upgrade --install \
	--kube-context "local" \
	--create-namespace --namespace "${APP_NS}" \
	"external-secrets" \
	"${REPO_NAME}/external-secrets"

#
# Deploy the default ClusterSecretStore
#
echo_run kubectl --context "local" apply -f "${BASEDIR}/resources/external-secrets.yaml"
