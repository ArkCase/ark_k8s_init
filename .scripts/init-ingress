#!/bin/bash
SCRIPT="$(readlink -f "${BASH_ARGV0:-${0}}")"
BASEDIR="$(dirname "${SCRIPT}")"
SCRIPT="$(basename "${SCRIPT}")"

set -e -o pipefail

echo_run()
{
	local ARGS=("${@}")
	echo "${ARGS[@]@Q}"
	"${@}"
}

REPO_NAME="traefik"
REPO_URL="https://traefik.github.io/charts"
[ -v INGRESS_APP_NAME ] || INGRESS_APP_NAME="traefik"
[ -v INGRESS_APP_NS ] || INGRESS_APP_NS="traefik"

helm repo add --force-update "${REPO_NAME}" "${REPO_URL}"

[ -v DEFAULT ] || DEFAULT=""
[ -n "${DEFAULT}" ] || DEFAULT="true"
case "${DEFAULT,,}" in
	true | t | yes | y | 1 ) DEFAULT="true" ;;
	* ) DEFAULT="false" ;;
esac

# Clean out the old crap ...
echo_run kubectl --context "local" delete IngressClass "haproxy" || true
echo_run helm --kube-context "local" --namespace ingress-controller delete "haproxy-ingress" || true
echo_run kubectl --context "local" delete namespace "haproxy-ingress" || true

# Add the new hawtnezz ...
echo_run kubectl --context "local" create -f - <<EOF
apiVersion: v1
kind: Namespace
metadata:
  labels:
    # Make sure this annotation matches the annotation used for trust-manager
    armedia-certificate-trusts/ca-trusts: "true"
  name: traefik
EOF
echo_run helm \
	--kube-context "local" \
	--namespace "${INGRESS_APP_NS}" \
	upgrade --install \
	"${INGRESS_APP_NAME}" \
	"${REPO_NAME}/${INGRESS_APP_NAME}" \
	-f "${BASEDIR}/values/traefik.yaml"
